# GEMINI_API_KEY: Optional - Required for Gemini AI matching & recommendations
GEMINI_API_KEY=""

# APP_URL: Production URL of your application (e.g. https://tutorlink.com.bd)
APP_URL="http://localhost:3000"

# Server Port & Environment
PORT=3000
NODE_ENV=production

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-pooler.supabase.com:6543/postgres"

# JWT Secret: Strong 64-character random secret used for session token signing
JWT_SECRET="replace-with-a-secure-random-64-character-hex-string"
